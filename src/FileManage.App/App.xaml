<Application x:Class="FileManage.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:FileManage.App"
             xmlns:conv="clr-namespace:FileManage.App.Converters"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 控件隐式样式 + 图标系统（Geometry + AppIcon 多尺寸样式，内嵌于此字典） -->
                <ResourceDictionary Source="Themes/Controls.xaml" />
                <!-- 默认主题与语言（App 启动时按 settings.json 覆盖） -->
                <ResourceDictionary Source="Themes/Light.xaml" />
                <ResourceDictionary Source="Localization/zh-CN.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <conv:ZeroToVisibleConverter x:Key="ZeroToVisibleConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
