<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
      控件隐式样式（主题无关）：仅通过 DynamicResource 引用画刷。
      实际配色见 Light.xaml / Dark.xaml，运行时可整体替换。
      注意：StaticResource 只允许引用本字典中已定义的资源，故 Calendar 相关样式按依赖顺序排列。
    -->

    <!-- 按钮：随主题的模板（悬停/按下/禁用） -->
    <Style TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource App.Button.Background}" />
        <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.Border}" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="4">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource App.Button.Hover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource App.Button.Pressed}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 主工具栏按钮：统一高度 / 字号 / 内边距，文本由内容撑开保证完整显示 -->
    <Style x:Key="AppToolBarButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="MinWidth" Value="96" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI" />
    </Style>

    <!-- 链接式按钮（状态栏版本标签）：无边框透明底，悬停显示主题色底 -->
    <Style x:Key="AppLinkButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource App.SubText}" />
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <!-- 下拉框：自绘模板使背景/弹出面板随主题 -->
    <Style TargetType="ComboBox">
        <Setter Property="Background" Value="{DynamicResource App.Input.Background}" />
        <Setter Property="Foreground" Value="{DynamicResource App.Input.Foreground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.Border}" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Bd"
                                            Background="{DynamicResource App.Input.Background}"
                                            BorderBrush="{DynamicResource App.Border}"
                                            BorderThickness="1" CornerRadius="2">
                                        <Path Data="M 0 0 L 4 4 L 8 0"
                                              Stroke="{DynamicResource App.SubText}" StrokeThickness="1.5"
                                              HorizontalAlignment="Right" VerticalAlignment="Center"
                                              Margin="0,0,8,0" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource App.Accent}" />
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource App.Item.Hover}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Left" VerticalAlignment="Center"
                                          IsHitTestVisible="False" />

                        <Popup x:Name="PART_Popup"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True" Placement="Bottom"
                               StaysOpen="False" PopupAnimation="Fade">
                            <Border Background="{DynamicResource App.Input.Background}"
                                    BorderBrush="{DynamicResource App.Border}" BorderThickness="1"
                                    CornerRadius="2" Margin="0,2,0,0"
                                    MinWidth="{TemplateBinding ActualWidth}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 下拉项：悬停/选中随主题 -->
    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Background="Transparent" Padding="8,5">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource App.Item.Hover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource App.Item.Selected}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 表格列头：随主题背景与前景 -->
    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{DynamicResource App.Panel.Background}" />
        <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.Border}" />
        <Setter Property="BorderThickness" Value="0,0,1,1" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridColumnHeader">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 分组框：标题内置 + 边框随主题 -->

    <Style TargetType="GroupBox">
        <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupBox">
                    <Border Background="{DynamicResource App.Panel.Background}"
                            BorderBrush="{DynamicResource App.Border}"
                            BorderThickness="1" CornerRadius="3"
                            Padding="{TemplateBinding Padding}" Margin="0,0,0,0">
                        <StackPanel>
                            <TextBlock Text="{TemplateBinding Header}" FontWeight="Bold"
                                       Margin="0,0,0,6" />
                            <ContentPresenter />
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 布尔转 Visibility（可折叠分组内容用） -->
    <BooleanToVisibilityConverter x:Key="AppBoolToVis" />

    <!-- 可折叠分组：Tag(bool)=展开状态（双向绑定 VM），头部可点击切换，箭头指示方向 -->
    <Style x:Key="AppCollapsibleGroup" TargetType="GroupBox" BasedOn="{StaticResource {x:Type GroupBox}}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupBox">
                    <Border Background="{DynamicResource App.Panel.Background}"
                            BorderBrush="{DynamicResource App.Border}"
                            BorderThickness="1" CornerRadius="3"
                            Padding="{TemplateBinding Padding}">
                        <StackPanel>
                            <ToggleButton FontWeight="Bold" Cursor="Hand"
                                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                          Background="Transparent" BorderThickness="0"
                                          Foreground="{DynamicResource App.Text}"
                                          Margin="0,0,0,6"
                                          ToolTip="{DynamicResource S.Tip.GroupToggle}"
                                          IsChecked="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          Content="{TemplateBinding Header}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" x:Name="Chev" Text="▾" Margin="6,0,0,0" />
                                                <ContentPresenter />
                                            </DockPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource App.Accent}" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="False">
                                                <Setter TargetName="Chev" Property="Text" Value="▸" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Visibility="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource AppBoolToVis}}" />
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 提示浮层 -->
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{DynamicResource App.Input.Background}" />
        <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.Border}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            CornerRadius="2" Padding="8,4">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 窗口：背景与前景（Foreground 沿视觉树传播到 TextBlock） -->
    <Style TargetType="Window">
        <Setter Property="Background" Value="{DynamicResource App.Window.Background}" />
        <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
    </Style>

    <!-- 输入框 -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource App.Input.Background}" />
        <Setter Property="Foreground" Value="{DynamicResource App.Input.Foreground}" />
        <Setter Property="CaretBrush" Value="{DynamicResource App.Input.Foreground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.Border}" />
    </Style>

    <Style TargetType="ListBox">
        <Setter Property="Background" Value="{DynamicResource App.Input.Background}" />
        <Setter Property="Foreground" Value="{DynamicResource App.Input.Foreground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.Border}" />
    </Style>

    <!-- 表格：背景在 MainWindow.xaml 直接设 DynamicResource（隐式 Style 的 DynamicResource 在主题切换后不跟随更新） -->
    <Style TargetType="DataGrid">
        <Setter Property="RowBackground" Value="Transparent" />
        <Setter Property="AlternatingRowBackground" Value="Transparent" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource App.Border}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.Border}" />
    </Style>

    <!-- DataGrid 行：透明背景，选中/悬停随主题 -->
    <Style TargetType="DataGridRow">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
    </Style>

    <!-- DataGrid 单元格：默认白色是深色模式最常见漏点 -->
    <Style TargetType="DataGridCell">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}">
                        <ContentPresenter VerticalAlignment="Center" Margin="6,4" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- DataGrid 行头：隐藏行头时不留白 -->
    <Style TargetType="DataGridRowHeader">
        <Setter Property="Background" Value="{DynamicResource App.Panel.Background}" />
        <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
        <Setter Property="Width" Value="0" />
        <Setter Property="MinWidth" Value="0" />
    </Style>

    <!-- 状态栏 -->
    <Style TargetType="StatusBar">
        <Setter Property="Background" Value="{DynamicResource App.Panel.Background}" />
        <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
    </Style>

    <!-- 复选框：自绘方框 + 对勾随主题 -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Box" Width="16" Height="16" CornerRadius="2"
                                Background="{DynamicResource App.Input.Background}"
                                BorderBrush="{DynamicResource App.Border}" BorderThickness="1"
                                VerticalAlignment="Center">
                            <Path x:Name="Check"
                                  Data="M 3.5 8 L 7 11.5 L 12.5 4.5"
                                  Stroke="{DynamicResource App.Accent}" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter Margin="6,0,0,0" VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource App.Accent}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource App.Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 单选钮：自绘圆圈随主题 -->
    <Style TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Circle" Width="16" Height="16" CornerRadius="8"
                                Background="{DynamicResource App.Input.Background}"
                                BorderBrush="{DynamicResource App.Border}" BorderThickness="1"
                                VerticalAlignment="Center">
                            <Ellipse x:Name="Dot" Width="8" Height="8"
                                     Fill="{DynamicResource App.Accent}"
                                     Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter Margin="6,0,0,0" VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Circle" Property="BorderBrush" Value="{DynamicResource App.Accent}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Circle" Property="BorderBrush" Value="{DynamicResource App.Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 滚动条：细条自绘，轨道透明、滑块随主题。键控样式供 ScrollViewer 模板显式引用。
         注意：Thumb 必须显式设置 Background（DynamicResource App.Border）——
         若依赖 TemplateBinding 而未赋值，滑块将回退 Aero2 默认灰色（深色模式白块根因） -->
    <Style x:Key="AppScrollBarStyle" TargetType="ScrollBar">
        <Setter Property="Width" Value="10" />
        <Setter Property="Background" Value="{DynamicResource App.Border}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Background="{DynamicResource App.Border}">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="Slide" Background="{TemplateBinding Background}"
                                                    CornerRadius="4" Margin="1,2" />
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource App.SubText}" />
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource App.Accent}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="Height" Value="10" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="Transparent">
                                <Track x:Name="PART_Track">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageLeftCommand" Focusable="False">
                                            <RepeatButton.Template>
                                                <ControlTemplate TargetType="RepeatButton">
                                                    <Border Background="Transparent" />
                                                </ControlTemplate>
                                            </RepeatButton.Template>
                                        </RepeatButton>
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageRightCommand" Focusable="False">
                                            <RepeatButton.Template>
                                                <ControlTemplate TargetType="RepeatButton">
                                                    <Border Background="Transparent" />
                                                </ControlTemplate>
                                            </RepeatButton.Template>
                                        </RepeatButton>
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb>
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Border x:Name="Slide" Background="{TemplateBinding Background}"
                                                            CornerRadius="4" Margin="2,1" />
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource App.SubText}" />
                                                        </Trigger>
                                                        <Trigger Property="IsDragging" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource App.Accent}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 隐式滚动条：沿用键控样式（逻辑树中的滚动条） -->
    <Style TargetType="ScrollBar" BasedOn="{StaticResource AppScrollBarStyle}" />

    <!-- 横向滚动条：供 ScrollViewer 模板显式引用（Orientation 置横向以切换轨道模板） -->
    <Style x:Key="AppHorizontalScrollBarStyle" TargetType="ScrollBar" BasedOn="{StaticResource AppScrollBarStyle}">
        <Setter Property="Orientation" Value="Horizontal" />
    </Style>

    <!-- 滚动视图：显式随窗口主题，避免默认白底/透明回退异常。
         自定义模板显式引用自绘滚动条：默认模板内置的滚动条不受隐式样式影响，深色主题下呈白条。
         注意：键控样式 + 元素上显式 Style 引用（本应用中隐式 Style 对部分控件不生效） -->
    <Style x:Key="AppScrollViewerStyle" TargetType="ScrollViewer">
        <Setter Property="Background" Value="{DynamicResource App.Window.Background}" />
        <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <!-- TemplateBinding：主窗口 ScrollViewer 显式设置主题背景；
                         DataGrid 内部 ScrollViewer 隐式样式含窗口背景 Setter，同样随主题 -->
                    <Grid Background="{TemplateBinding Background}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ScrollContentPresenter Grid.RowSpan="2" Grid.ColumnSpan="2"
                                                Margin="{TemplateBinding Padding}"
                                                CanContentScroll="{TemplateBinding CanContentScroll}" />
                        <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1"
                                   Style="{StaticResource AppScrollBarStyle}"
                                   Value="{TemplateBinding VerticalOffset}"
                                   Maximum="{TemplateBinding ScrollableHeight}"
                                   ViewportSize="{TemplateBinding ViewportHeight}"
                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
                        <ScrollBar x:Name="PART_HorizontalScrollBar" Grid.Row="1"
                                   Style="{StaticResource AppHorizontalScrollBarStyle}"
                                   Value="{TemplateBinding HorizontalOffset}"
                                   Maximum="{TemplateBinding ScrollableWidth}"
                                   ViewportSize="{TemplateBinding ViewportWidth}"
                                   Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollViewer" BasedOn="{StaticResource AppScrollViewerStyle}" />

    <!-- 日历：月视图容器（CalendarItem）。须先于 AppCalendarStyle 定义 -->
    <Style x:Key="AppCalendarItemStyle" TargetType="CalendarItem">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CalendarItem">
                    <ControlTemplate.Resources>
                        <Style x:Key="DayTitleStyle" TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource App.SubText}" />
                            <Setter Property="FontSize" Value="11" />
                            <Setter Property="HorizontalAlignment" Value="Center" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="Margin" Value="0,4,0,2" />
                        </Style>
                    </ControlTemplate.Resources>
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource App.Border}" BorderThickness="1"
                            CornerRadius="2" Margin="0,2,0,0" Padding="4">
                        <StackPanel>
                            <Grid Margin="4,2,4,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="PART_PreviousButton" Width="26" Height="22" Focusable="False">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="B" Background="Transparent" CornerRadius="2">
                                                <Path Data="M 6 0 L 1 5 L 6 10" Stroke="{DynamicResource App.Text}"
                                                      StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="B" Property="Background" Value="{DynamicResource App.Item.Hover}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Button x:Name="PART_HeaderButton" Grid.Column="1" Focusable="False"
                                        Foreground="{DynamicResource App.Text}" FontSize="13" FontWeight="Bold">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="B" Background="Transparent" CornerRadius="2" Padding="6,3">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="B" Property="Background" Value="{DynamicResource App.Item.Hover}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Button x:Name="PART_NextButton" Grid.Column="2" Width="26" Height="22" Focusable="False">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="B" Background="Transparent" CornerRadius="2">
                                                <Path Data="M 1 0 L 6 5 L 1 10" Stroke="{DynamicResource App.Text}"
                                                      StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="B" Property="Background" Value="{DynamicResource App.Item.Hover}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                            <!-- 部件名/行列结构为 Calendar 填充约定：PART_MonthView 7x7、PART_YearView 3x4 -->
                            <Grid x:Name="PART_MonthView" Margin="2,0,2,4" HorizontalAlignment="Center">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" /><ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="28" /><ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="28" /><ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="28" />
                                </Grid.ColumnDefinitions>
                            </Grid>
                            <Grid x:Name="PART_YearView" Visibility="Hidden" Margin="2,0,2,4">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="28" /><RowDefinition Height="28" />
                                    <RowDefinition Height="28" /><RowDefinition Height="28" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="52" /><ColumnDefinition Width="52" />
                                    <ColumnDefinition Width="52" /><ColumnDefinition Width="52" />
                                </Grid.ColumnDefinitions>
                            </Grid>
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 日历：容器（引用上方 AppCalendarItemStyle） -->
    <Style x:Key="AppCalendarStyle" TargetType="Calendar">
        <Setter Property="Background" Value="{DynamicResource App.Input.Background}" />
        <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.Border}" />
        <Setter Property="CalendarItemStyle" Value="{StaticResource AppCalendarItemStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Calendar">
                    <StackPanel x:Name="PART_Root">
                        <CalendarItem x:Name="PART_CalendarItem"
                                      Background="{TemplateBinding Background}"
                                      Foreground="{TemplateBinding Foreground}"
                                      BorderBrush="{TemplateBinding BorderBrush}"
                                      Style="{TemplateBinding CalendarItemStyle}" />
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 日期选择：自绘输入框 + 日历图标按钮（Calendar 由 DatePicker 注入 PART_Popup） -->
    <Style TargetType="DatePicker">
        <Setter Property="Background" Value="{DynamicResource App.Input.Background}" />
        <Setter Property="Foreground" Value="{DynamicResource App.Input.Foreground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.Border}" />
        <Setter Property="CalendarStyle" Value="{StaticResource AppCalendarStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DatePicker">
                    <Grid x:Name="PART_Root">
                        <Border x:Name="Bd"
                                Background="{DynamicResource App.Input.Background}"
                                BorderBrush="{DynamicResource App.Border}"
                                BorderThickness="1" CornerRadius="2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <DatePickerTextBox x:Name="PART_TextBox"
                                                   Background="Transparent" BorderThickness="0"
                                                   Foreground="{DynamicResource App.Input.Foreground}"
                                                   CaretBrush="{DynamicResource App.Input.Foreground}"
                                                   Padding="6,3" VerticalContentAlignment="Center" />
                                <Button x:Name="PART_Button" Grid.Column="1" Width="24" Focusable="False" ClickMode="Press">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="B" Background="Transparent">
                                                <Path Data="M 0,0.5 H 13 V 13 H 0 Z M 0,3.5 H 13 M 3,6 H 5 M 8,6 H 10 M 3,9 H 5 M 8,9 H 10"
                                                      Stroke="{DynamicResource App.SubText}" StrokeThickness="1"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="B" Property="Background" Value="{DynamicResource App.Item.Hover}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </Border>
                        <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom"
                               StaysOpen="False" PopupAnimation="Fade"
                               IsOpen="{TemplateBinding IsDropDownOpen}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource App.Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 日历日期格：悬停/选中/今天/邻月 -->
    <Style TargetType="CalendarDayButton">
        <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CalendarDayButton">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="2" Margin="1">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,3" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource App.Item.Hover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource App.Item.Selected}" />
                        </Trigger>
                        <Trigger Property="IsToday" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource App.Accent}" />
                            <Setter TargetName="Bd" Property="BorderThickness" Value="1" />
                        </Trigger>
                        <Trigger Property="IsInactive" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource App.SubText}" />
                        </Trigger>
                        <Trigger Property="IsBlackedOut" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource App.Border}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 日历年/月格 -->
    <Style TargetType="CalendarButton">
        <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CalendarButton">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="2" Margin="1">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource App.Item.Hover}" />
                        </Trigger>
                        <Trigger Property="IsInactive" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource App.SubText}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 菜单栏：顶栏随窗口主题，底部 1px 分隔线 -->
    <Style TargetType="Menu">
        <Setter Property="Background" Value="{DynamicResource App.Window.Background}" />
        <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
        <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI" />
        <Setter Property="Padding" Value="4,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Menu">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource App.Border}"
                            BorderThickness="0,0,0,1">
                        <ItemsPresenter Margin="{TemplateBinding Padding}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 顶栏菜单标题模板：悬停/展开随主题，弹出层淡入 -->
    <ControlTemplate x:Key="AppTopLevelMenuItemTemplate" TargetType="MenuItem">
        <Grid>
            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                    CornerRadius="3" Padding="10,5" Margin="2,2">
                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"
                                  VerticalAlignment="Center" />
            </Border>
            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsSubmenuOpen}"
                   Focusable="False" AllowsTransparency="True"
                   Placement="Bottom" PopupAnimation="Fade" StaysOpen="False">
                <Border Background="{DynamicResource App.Input.Background}"
                        BorderBrush="{DynamicResource App.Border}" BorderThickness="1"
                        CornerRadius="3" Margin="0,3,0,0" Padding="0,4"
                        MaxHeight="420">
                    <StackPanel IsItemsHost="True"
                                KeyboardNavigation.DirectionalNavigation="Cycle" />
                </Border>
            </Popup>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource App.Item.Hover}" />
            </Trigger>
            <Trigger Property="IsSubmenuOpen" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource App.Item.Selected}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- 子菜单项模板：图标列（默认显示 Icon；可勾选项选中时显示对勾覆盖） + 标题 + 快捷键提示 -->
    <ControlTemplate x:Key="AppSubMenuItemTemplate" TargetType="MenuItem">
        <Border x:Name="Bd" Background="Transparent" Padding="10,6" Margin="4,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ContentPresenter Grid.Column="0" ContentSource="Icon" Width="16" Height="16"
                                  VerticalAlignment="Center" HorizontalAlignment="Center" />
                <Path x:Name="Check" Grid.Column="0" Data="M 2 8 L 7 13 L 14 3"
                      Stroke="{DynamicResource App.Accent}" StrokeThickness="2"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Width="16" Height="16" Stretch="Uniform"
                      VerticalAlignment="Center" HorizontalAlignment="Center"
                      Visibility="Collapsed" />
                <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True"
                                  VerticalAlignment="Center" Margin="6,0,0,0" />
                <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}"
                           Foreground="{DynamicResource App.SubText}" Margin="20,0,0,0"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource App.Item.Hover}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- 菜单项：按角色切换模板（顶栏标题 / 子菜单项），配色全部随主题 -->
    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template" Value="{StaticResource AppSubMenuItemTemplate}" />
        <Style.Triggers>
            <Trigger Property="Role" Value="TopLevelHeader">
                <Setter Property="Template" Value="{StaticResource AppTopLevelMenuItemTemplate}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 菜单内分隔线 -->
    <Style TargetType="Separator">
        <Setter Property="Background" Value="{DynamicResource App.Border}" />
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="10,4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Background="{TemplateBinding Background}" Height="1" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 进度条：轨道随主题，进度块用主题强调色 -->
    <Style TargetType="ProgressBar">
        <Setter Property="Foreground" Value="{DynamicResource App.Accent}" />
        <Setter Property="Height" Value="14" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border Background="{DynamicResource App.Input.Background}"
                            BorderBrush="{DynamicResource App.Border}" BorderThickness="1" CornerRadius="2">
                        <Grid>
                            <Border x:Name="PART_Track" />
                            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}"
                                    HorizontalAlignment="Left" CornerRadius="1" Margin="1" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 选项卡：标签随主题（悬停/选中态），内容区随面板底色，避免深色模式白底残留 -->
    <Style TargetType="TabControl">
        <Setter Property="Background" Value="{DynamicResource App.Panel.Background}" />
        <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.Border}" />
    </Style>
    <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Margin" Value="0,0,2,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Bd" Background="Transparent"
                            BorderBrush="{DynamicResource App.Border}" BorderThickness="1,1,1,0"
                            CornerRadius="4,4,0,0" Padding="{TemplateBinding Padding}">
                        <ContentPresenter ContentSource="Header" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource App.Item.Hover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource App.Panel.Background}" />
                            <Setter Property="Foreground" Value="{DynamicResource App.Accent}" />
                            <Setter Property="FontWeight" Value="Bold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         FileManage 图标系统 · 视觉规范（与 Lucide/Hugeicons 线性系对齐）
         · viewBox 0 0 24 24  · stroke 1.5  · linecap/linejoin round  · fill none
         · 颜色由 Path.Stroke={DynamicResource App.Text} 继承，随主题切换
         · PNG/SVG 等价物见 assets/icons/ 与 scripts/generate-icons.ps1
         ============================================================ -->

    <!-- P1 核心工具栏 -->
    <StreamGeometry x:Key="Icon.Refresh">M21 12a9 9 0 1 1-2.64-6.36M21 4v5h-5</StreamGeometry>
    <StreamGeometry x:Key="Icon.Execute">M5 3l14 9-14 9V3z</StreamGeometry>
    <StreamGeometry x:Key="Icon.Undo">M9 14L4 9l5-5M4 9h11a5 5 0 0 1 0 10h-4</StreamGeometry>
    <StreamGeometry x:Key="Icon.History">M12 8v5l3 2M3 12a9 9 0 1 0 18 0 9 9 0 0 0-18 0z</StreamGeometry>
    <StreamGeometry x:Key="Icon.Duplicate">M9 9h10v10H9zM4 14V4h10</StreamGeometry>
    <StreamGeometry x:Key="Icon.ScanExport">M4 4h6v2H6v12h12v-4h2v6H4V4zM14 4h6v6h-2V7.41l-5.29 5.3-1.42-1.42 5.3-5.29H14V4z</StreamGeometry>
    <StreamGeometry x:Key="Icon.Restore">M9 14l-5-5 5-5M4 9h7a5 5 0 0 1 5 5v1M20 4v6h-6</StreamGeometry>
    <StreamGeometry x:Key="Icon.EmptyPreview">M3 3h18v14H3zM3 21h18M9 7h6M9 11h4</StreamGeometry>
    <StreamGeometry x:Key="Icon.Update">M12 4V2L8 6l4 4V8a4 4 0 1 1-4 4H6a6 6 0 1 0 6-6z</StreamGeometry>
    <StreamGeometry x:Key="Icon.RuleEditor">M4 6h16M4 12h16M4 18h10M5 6v12M5 6V4h14v2</StreamGeometry>
    <StreamGeometry x:Key="Icon.Browse">M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7z</StreamGeometry>

    <!-- P2 菜单 -->
    <StreamGeometry x:Key="Icon.Appearance">M12 2v6m0 8v6M2 12h6m8 0h6M5 5l4 4m6 6l4 4M19 5l-4 4m-6 6l-4 4</StreamGeometry>
    <StreamGeometry x:Key="Icon.Language">M3 5h12M9 3v2c0 5-3 9-6 10M5 9c2 4 6 6 9 6M14 21l5-11 5 11M16.5 17h5</StreamGeometry>
    <StreamGeometry x:Key="Icon.Tools">M14 7a4 4 0 1 1-8 0M3 21l6-6M21 21l-5-5M9 3h8l4 4-4 4-4-4V3z</StreamGeometry>
    <StreamGeometry x:Key="Icon.Help">M9 9a3 3 0 1 1 4 3c-1 1-1 2-1 3M12 17h.01M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18z</StreamGeometry>
    <StreamGeometry x:Key="Icon.About">M12 8h.01M11 12h1v4h1M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18z</StreamGeometry>
    <StreamGeometry x:Key="Icon.Homepage">M14 3h7v7M21 3l-9 9M10 14L3 21M3 14v7h7</StreamGeometry>
    <StreamGeometry x:Key="Icon.Guide">M4 4h12a2 2 0 0 1 2 2v14H6a2 2 0 0 1-2-2V4zM8 8h6M8 12h6M8 16h4</StreamGeometry>
    <StreamGeometry x:Key="Icon.Faq">M21 11.5a8.5 8.5 0 1 1-17 0 8.5 8.5 0 0 1 17 0zM10 9a2 2 0 1 1 3 1.5c-.8.6-1 1-1 1.5M12 16h.01</StreamGeometry>

    <!-- P3 辅助按钮 -->
    <StreamGeometry x:Key="Icon.Add">M12 5v14M5 12h14</StreamGeometry>
    <StreamGeometry x:Key="Icon.Delete">M4 7h16M9 7V4h6v3M6 7l1 13h10l1-13M10 11v6M14 11v6</StreamGeometry>
    <StreamGeometry x:Key="Icon.Up">M12 19V5M5 12l7-7 7 7</StreamGeometry>
    <StreamGeometry x:Key="Icon.Down">M12 5v14M5 12l7 7 7-7</StreamGeometry>
    <StreamGeometry x:Key="Icon.Save">M5 3h12l4 4v14H3V3zM8 3v5h8M8 13h8v8H8z</StreamGeometry>
    <StreamGeometry x:Key="Icon.Close">M6 6l12 12M6 18L18 6</StreamGeometry>
    <StreamGeometry x:Key="Icon.Import">M12 3v12M7 8l5 5 5-5M4 17v2h16v-2</StreamGeometry>
    <StreamGeometry x:Key="Icon.Export">M12 3v12M7 10l5-5 5 5M4 17v2h16v-2</StreamGeometry>
    <StreamGeometry x:Key="Icon.Copy">M9 9h10v10H9zM4 14V4h10v2</StreamGeometry>
    <StreamGeometry x:Key="Icon.Rename">M4 20h4l10-10-4-4L4 16v4zM14 6l4 4</StreamGeometry>

    <!-- P4 分组与窗口标题 -->
    <StreamGeometry x:Key="Icon.Source">M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7zM3 11h18</StreamGeometry>
    <StreamGeometry x:Key="Icon.RenameGroup">M3 9l4-4h4l8 8-4 4-8-8V9zM7 5l4 4</StreamGeometry>
    <StreamGeometry x:Key="Icon.Classify">M3 7l4-4h4l8 8-4 4-8-8V7zM7 3l4 4M9 17h12</StreamGeometry>
    <StreamGeometry x:Key="Icon.ExecOptions">M12 8v4l3 2M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18z</StreamGeometry>

    <!-- 通用：警告、成功、信息（通知场景） -->
    <StreamGeometry x:Key="Icon.Warning">M12 3l10 18H2L12 3zM12 9v4M12 17h.01</StreamGeometry>
    <StreamGeometry x:Key="Icon.Success">M20 6L9 17l-5-5</StreamGeometry>
    <StreamGeometry x:Key="Icon.Info">M12 8h.01M11 12h1v4h1M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18z</StreamGeometry>

    <!-- AppIcon 多尺寸样式：矢量绘制规范（stroke 1.5 / round / fill none / 随主题着色） -->
    <Style x:Key="AppIcon" TargetType="Path">
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Stroke" Value="{DynamicResource App.Text}" />
        <Setter Property="StrokeThickness" Value="1.5" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="Fill" Value="{x:Null}" />
        <Setter Property="RenderOptions.EdgeMode" Value="Unspecified" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>
    <Style x:Key="AppIcon16" TargetType="Path" BasedOn="{StaticResource AppIcon}">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
    </Style>
    <Style x:Key="AppIcon20" TargetType="Path" BasedOn="{StaticResource AppIcon}">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
    </Style>
    <Style x:Key="AppIcon24" TargetType="Path" BasedOn="{StaticResource AppIcon}">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
    </Style>
    <Style x:Key="AppIcon32" TargetType="Path" BasedOn="{StaticResource AppIcon}">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
    </Style>
    <Style x:Key="AppIcon48" TargetType="Path" BasedOn="{StaticResource AppIcon}">
        <Setter Property="Width" Value="48" />
        <Setter Property="Height" Value="48" />
    </Style>

</ResourceDictionary>
