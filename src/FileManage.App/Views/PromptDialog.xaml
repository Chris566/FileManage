<Window x:Class="FileManage.App.Views.PromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="400" SizeToContent="Height"
        Background="{DynamicResource App.Window.Background}"
        Foreground="{DynamicResource App.Text}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        ResizeMode="NoResize" WindowStyle="ToolWindow">
    <StackPanel Margin="14">
        <TextBlock x:Name="LabelText" TextWrapping="Wrap" />
        <TextBox x:Name="AnswerBox" Margin="0,8,0,0" Padding="4,3" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{DynamicResource S.Common.Ok}" IsDefault="True" Click="OnOk" Padding="16,5" />
            <Button Content="{DynamicResource S.Common.Cancel}" IsCancel="True" Margin="8,0,0,0" Padding="16,5" />
        </StackPanel>
    </StackPanel>
</Window>
