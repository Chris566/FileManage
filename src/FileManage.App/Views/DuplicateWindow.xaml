<Window x:Class="FileManage.App.Views.DuplicateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource S.D.Title}" Height="560" Width="820" MinHeight="420" MinWidth="640"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="10">

        <!-- 底部：统计与操作 -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="{DynamicResource S.D.DeleteChecked}" Command="{Binding DeleteCheckedCommand}"
                        Padding="12,6" FontWeight="Bold" />
                <Button Content="{DynamicResource S.D.Close}" IsCancel="True" Padding="12,6" MinWidth="72" Margin="8,0,0,0" />
            </StackPanel>
            <TextBlock Text="{Binding SummaryText}" VerticalAlignment="Center" TextWrapping="Wrap" />
        </DockPanel>

        <!-- 顶部：扫描参数 -->
        <DockPanel DockPanel.Dock="Top">
            <Button DockPanel.Dock="Right" Content="{DynamicResource S.D.Scan}" Command="{Binding ScanCommand}"
                    Padding="16,5" FontWeight="Bold" Margin="8,0,0,0" />
            <TextBox Text="{Binding Directory, UpdateSourceTrigger=PropertyChanged}"
                     VerticalContentAlignment="Center" />
        </DockPanel>
        <CheckBox DockPanel.Dock="Top" Content="{DynamicResource S.D.IncludeSub}"
                  IsChecked="{Binding IncludeSubdirectories}" Margin="0,6,0,0" />

        <!-- 组列表 -->
        <ListBox ItemsSource="{Binding Groups}"
                 SelectedItem="{Binding SelectedGroup}"
                 Margin="0,8,0,0"
                 VirtualizingPanel.VirtualizationMode="Recycling">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Expander Header="{Binding SizeText}" IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
                        <ItemsControl ItemsSource="{Binding Files}" Margin="18,4,0,4">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{Binding IsChecked}"
                                                  VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Margin="6,0,8,0"
                                                   Text="{Binding FullPath}"
                                                   ToolTip="{Binding FullPath}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding ModifiedTime, StringFormat=yyyy-MM-dd HH:mm}"
                                                   Foreground="#888" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Expander>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
