<Window x:Class="FileManage.App.Views.RuleEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource S.RE.Title}" Height="560" Width="820" MinHeight="480" MinWidth="700"
        Background="{DynamicResource App.Window.Background}"
        Foreground="{DynamicResource App.Text}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="10">

        <!-- 顶部：预设条（切换即生效；系统默认预设带只读徽标，删除受保护） -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock DockPanel.Dock="Right" Text="{Binding PresetBadge}" VerticalAlignment="Center"
                       Foreground="{DynamicResource App.SubText}" Margin="10,0,0,0"
                       TextTrimming="CharacterEllipsis" MinWidth="140" TextAlignment="Right" />
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{DynamicResource S.Preset.Label}" VerticalAlignment="Center" />
                <ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}"
                          Width="230" Margin="6,0,10,0">
                    <!-- 显式 ItemTemplate：自定义模板下选中框的 SelectionBoxItemTemplate 不吸收 DisplayMemberPath，会导致显示原始 ToString -->
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayName}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Command="{Binding NewPresetCommand}" Padding="8,4" ToolTip="{DynamicResource S.Preset.New}">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource AppIcon16}" Data="{DynamicResource Icon.Add}" />
                        <TextBlock Text="{DynamicResource S.Preset.New}" Margin="4,0,0,0" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding CopyPresetCommand}" Padding="8,4" Margin="4,0,0,0" ToolTip="{DynamicResource S.Preset.CopyBtn}">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource AppIcon16}" Data="{DynamicResource Icon.Copy}" />
                        <TextBlock Text="{DynamicResource S.Preset.CopyBtn}" Margin="4,0,0,0" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding RenamePresetCommand}" Padding="8,4" Margin="4,0,0,0" ToolTip="{DynamicResource S.Preset.Rename}">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource AppIcon16}" Data="{DynamicResource Icon.Rename}" />
                        <TextBlock Text="{DynamicResource S.Preset.Rename}" Margin="4,0,0,0" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding DeletePresetCommand}" Padding="8,4" Margin="4,0,0,0" ToolTip="{DynamicResource S.Preset.DeleteBtn}">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource AppIcon16}" Data="{DynamicResource Icon.Delete}" />
                        <TextBlock Text="{DynamicResource S.Preset.DeleteBtn}" Margin="4,0,0,0" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </DockPanel>

        <!-- 底部状态与按钮 -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Command="{Binding ImportCommand}" Padding="12,6" MinWidth="72" ToolTip="{DynamicResource S.RE.Import}">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource AppIcon16}" Data="{DynamicResource Icon.Import}" VerticalAlignment="Center" />
                        <TextBlock Text="{DynamicResource S.RE.Import}" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding ExportCommand}" Padding="12,6" MinWidth="72" Margin="8,0,0,0" ToolTip="{DynamicResource S.RE.Export}">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource AppIcon16}" Data="{DynamicResource Icon.Export}" VerticalAlignment="Center" />
                        <TextBlock Text="{DynamicResource S.RE.Export}" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding SaveCommand}" Padding="12,6" MinWidth="72" Margin="8,0,0,0" ToolTip="{DynamicResource S.RE.Save}">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource AppIcon16}" Data="{DynamicResource Icon.Save}" VerticalAlignment="Center" />
                        <TextBlock Text="{DynamicResource S.RE.Save}" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button IsCancel="True" Padding="12,6" MinWidth="72" Margin="8,0,0,0" ToolTip="{DynamicResource S.RE.Close}">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource AppIcon16}" Data="{DynamicResource Icon.Close}" VerticalAlignment="Center" />
                        <TextBlock Text="{DynamicResource S.RE.Close}" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </DockPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左：规则列表 -->
            <DockPanel Grid.Column="0" Margin="0,0,10,0">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                    <Button Command="{Binding AddCommand}" Padding="8,4" ToolTip="{DynamicResource S.RE.Add}">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource AppIcon16}" Data="{DynamicResource Icon.Add}" />
                            <TextBlock Text="{DynamicResource S.RE.Add}" Margin="4,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding DeleteCommand}" Padding="8,4" Margin="4,0,0,0" ToolTip="{DynamicResource S.RE.Delete}">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource AppIcon16}" Data="{DynamicResource Icon.Delete}" />
                            <TextBlock Text="{DynamicResource S.RE.Delete}" Margin="4,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding MoveUpCommand}" Padding="8,4" Margin="4,0,0,0" ToolTip="{DynamicResource S.RE.Up}">
                        <Path Style="{StaticResource AppIcon16}" Data="{DynamicResource Icon.Up}" />
                    </Button>
                    <Button Command="{Binding MoveDownCommand}" Padding="8,4" Margin="4,0,0,0" ToolTip="{DynamicResource S.RE.Down}">
                        <Path Style="{StaticResource AppIcon16}" Data="{DynamicResource Icon.Down}" />
                    </Button>
                </StackPanel>
                <ListBox ItemsSource="{Binding Rules}"
                         SelectedItem="{Binding SelectedRule}"
                         DisplayMemberPath="DisplayName" />
            </DockPanel>

            <!-- 右：编辑面板（系统默认预设下锁定为只读） -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                          IsEnabled="{Binding CanEditSelection}"
                          DataContext="{Binding SelectedRule}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource S.RE.Name}" />
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8" />

                    <TextBlock Text="{DynamicResource S.RE.Target}" />
                    <TextBox Text="{Binding TargetSubfolder, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8" />

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <CheckBox Content="{DynamicResource S.RE.Enabled}" IsChecked="{Binding Enabled}" Margin="0,0,16,0" />
                        <CheckBox Content="{DynamicResource S.RE.Copy}" IsChecked="{Binding CopyInsteadOfMove}" />
                    </StackPanel>

                    <Separator Margin="0,4,0,10" />
                    <TextBlock Text="{DynamicResource S.RE.Conditions}" FontWeight="Bold" Margin="0,0,0,6" />

                    <TextBlock Text="{DynamicResource S.RE.Exts}" />
                    <TextBox Text="{Binding ExtensionsText, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8" />

                    <TextBlock Text="{DynamicResource S.RE.Regex}" />
                    <TextBox Text="{Binding NameRegexText, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8" />

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                        <CheckBox Content="{DynamicResource S.RE.UseSize}" IsChecked="{Binding UseSize}" VerticalAlignment="Center" />
                        <TextBox Text="{Binding MinSizeText}" Width="110" Margin="8,0,4,0" />
                        <TextBlock Text="~" VerticalAlignment="Center" />
                        <TextBox Text="{Binding MaxSizeText}" Width="110" Margin="4,0,0,0" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,8,0,2">
                        <CheckBox Content="{DynamicResource S.RE.UseDate}" IsChecked="{Binding UseDate}" VerticalAlignment="Center" />
                        <DatePicker SelectedDate="{Binding FromDate}" Width="130" Margin="8,0,4,0" />
                        <TextBlock Text="~" VerticalAlignment="Center" />
                        <DatePicker SelectedDate="{Binding ToDate}" Width="130" Margin="4,0,0,0" />
                    </StackPanel>

                    <Separator Margin="0,10,0,10" />
                    <TextBlock Text="{DynamicResource S.RE.Summary}" FontWeight="Bold" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding ConditionSummary}" TextWrapping="Wrap" Foreground="{DynamicResource App.SubText}" />

                    <TextBlock Text="{DynamicResource S.RE.Hint}"
                               TextWrapping="Wrap" Foreground="{DynamicResource App.SubText}" Margin="0,16,0,0" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
