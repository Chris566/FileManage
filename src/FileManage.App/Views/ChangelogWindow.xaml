<Window x:Class="FileManage.App.Views.ChangelogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource S.Changelog.Title}" Width="560" Height="480"
        Background="{DynamicResource App.Window.Background}"
        Foreground="{DynamicResource App.Text}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="12">
        <TextBox x:Name="ContentBox" IsReadOnly="True" IsReadOnlyCaretVisible="True"
                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                 Background="Transparent" BorderThickness="0"
                 FontFamily="Consolas, Microsoft YaHei UI" FontSize="13" />
    </Grid>
</Window>
