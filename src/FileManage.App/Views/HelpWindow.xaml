<Window x:Class="FileManage.App.Views.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource S.Help.Title}" Width="680" Height="580" MinHeight="420" MinWidth="520"
        Background="{DynamicResource App.Window.Background}"
        Foreground="{DynamicResource App.Text}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">

    <DockPanel Margin="16">
        <!-- 底部：外链 + 关闭 -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Button Content="{DynamicResource S.Help.Close}" IsCancel="True"
                    DockPanel.Dock="Right" Padding="14,6" />
            <StackPanel Orientation="Horizontal">
                <Button Content="{DynamicResource S.Help.Homepage}" Click="OpenHomepage_Click" Padding="14,6" />
                <Button Content="{DynamicResource S.Help.Issues}" Click="OpenIssues_Click" Padding="14,6" Margin="8,0,0,0" />
            </StackPanel>
        </DockPanel>

        <TabControl x:Name="Tabs" SelectedIndex="0" Margin="0,4,0,0">
            <!-- 用户指南：13 张卡片（图标 + 标题 + 编号步骤） -->
            <TabItem Header="{DynamicResource S.Help.GuideTab}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                    <StackPanel Margin="4,0,8,4">

                        <!-- ① 快速上手 -->
                        <Border Background="{DynamicResource App.Panel.Background}"
                                BorderBrush="{DynamicResource App.Border}" BorderThickness="1"
                                CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Viewbox Grid.Column="0" Width="22" Height="22" VerticalAlignment="Top" Stretch="Uniform" Margin="0,2,0,0">
                                    <Path Data="{DynamicResource Icon.Refresh}" Fill="{DynamicResource App.Accent}" Stretch="Fill" />
                                </Viewbox>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                    <TextBlock Text="{DynamicResource S.Help.Guide.Quick.T}" FontWeight="SemiBold" FontSize="13" />
                                    <TextBlock Text="{DynamicResource S.Help.Guide.Quick.B}" TextWrapping="Wrap"
                                               Foreground="{DynamicResource App.SubText}" FontSize="12"
                                               LineStackingStrategy="MaxHeight" LineHeight="18" Margin="0,4,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- ② 源目录 / 拖放 -->
                        <Border Background="{DynamicResource App.Panel.Background}"
                                BorderBrush="{DynamicResource App.Border}" BorderThickness="1"
                                CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Viewbox Grid.Column="0" Width="22" Height="22" VerticalAlignment="Top" Stretch="Uniform" Margin="0,2,0,0">
                                    <Path Data="{DynamicResource Icon.Browse}" Fill="{DynamicResource App.Accent}" Stretch="Fill" />
                                </Viewbox>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                    <TextBlock Text="{DynamicResource S.Help.Guide.Source.T}" FontWeight="SemiBold" FontSize="13" />
                                    <TextBlock Text="{DynamicResource S.Help.Guide.Source.B}" TextWrapping="Wrap"
                                               Foreground="{DynamicResource App.SubText}" FontSize="12"
                                               LineStackingStrategy="MaxHeight" LineHeight="18" Margin="0,4,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- ③ 批量重命名 -->
                        <Border Background="{DynamicResource App.Panel.Background}"
                                BorderBrush="{DynamicResource App.Border}" BorderThickness="1"
                                CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Viewbox Grid.Column="0" Width="22" Height="22" VerticalAlignment="Top" Stretch="Uniform" Margin="0,2,0,0">
                                    <Path Data="{DynamicResource Icon.RenameGroup}" Fill="{DynamicResource App.Accent}" Stretch="Fill" />
                                </Viewbox>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                    <TextBlock Text="{DynamicResource S.Help.Guide.Rename.T}" FontWeight="SemiBold" FontSize="13" />
                                    <TextBlock Text="{DynamicResource S.Help.Guide.Rename.B}" TextWrapping="Wrap"
                                               Foreground="{DynamicResource App.SubText}" FontSize="12"
                                               LineStackingStrategy="MaxHeight" LineHeight="18" Margin="0,4,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- ④ 分类整理 -->
                        <Border Background="{DynamicResource App.Panel.Background}"
                                BorderBrush="{DynamicResource App.Border}" BorderThickness="1"
                                CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Viewbox Grid.Column="0" Width="22" Height="22" VerticalAlignment="Top" Stretch="Uniform" Margin="0,2,0,0">
                                    <Path Data="{DynamicResource Icon.Classify}" Fill="{DynamicResource App.Accent}" Stretch="Fill" />
                                </Viewbox>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                    <TextBlock Text="{DynamicResource S.Help.Guide.Classify.T}" FontWeight="SemiBold" FontSize="13" />
                                    <TextBlock Text="{DynamicResource S.Help.Guide.Classify.B}" TextWrapping="Wrap"
                                               Foreground="{DynamicResource App.SubText}" FontSize="12"
                                               LineStackingStrategy="MaxHeight" LineHeight="18" Margin="0,4,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- ⑤ 规则管理 -->
                        <Border Background="{DynamicResource App.Panel.Background}"
                                BorderBrush="{DynamicResource App.Border}" BorderThickness="1"
                                CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Viewbox Grid.Column="0" Width="22" Height="22" VerticalAlignment="Top" Stretch="Uniform" Margin="0,2,0,0">
                                    <Path Data="{DynamicResource Icon.RuleEditor}" Fill="{DynamicResource App.Accent}" Stretch="Fill" />
                                </Viewbox>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                    <TextBlock Text="{DynamicResource S.Help.Guide.RuleEditor.T}" FontWeight="SemiBold" FontSize="13" />
                                    <TextBlock Text="{DynamicResource S.Help.Guide.RuleEditor.B}" TextWrapping="Wrap"
                                               Foreground="{DynamicResource App.SubText}" FontSize="12"
                                               LineStackingStrategy="MaxHeight" LineHeight="18" Margin="0,4,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- ⑥ 规则预设 -->
                        <Border Background="{DynamicResource App.Panel.Background}"
                                BorderBrush="{DynamicResource App.Border}" BorderThickness="1"
                                CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Viewbox Grid.Column="0" Width="22" Height="22" VerticalAlignment="Top" Stretch="Uniform" Margin="0,2,0,0">
                                    <Path Data="{DynamicResource Icon.Save}" Fill="{DynamicResource App.Accent}" Stretch="Fill" />
                                </Viewbox>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                    <TextBlock Text="{DynamicResource S.Help.Guide.Preset.T}" FontWeight="SemiBold" FontSize="13" />
                                    <TextBlock Text="{DynamicResource S.Help.Guide.Preset.B}" TextWrapping="Wrap"
                                               Foreground="{DynamicResource App.SubText}" FontSize="12"
                                               LineStackingStrategy="MaxHeight" LineHeight="18" Margin="0,4,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- ⑦ 扫描导出报表 -->
                        <Border Background="{DynamicResource App.Panel.Background}"
                                BorderBrush="{DynamicResource App.Border}" BorderThickness="1"
                                CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Viewbox Grid.Column="0" Width="22" Height="22" VerticalAlignment="Top" Stretch="Uniform" Margin="0,2,0,0">
                                    <Path Data="{DynamicResource Icon.ScanExport}" Fill="{DynamicResource App.Accent}" Stretch="Fill" />
                                </Viewbox>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                    <TextBlock Text="{DynamicResource S.Help.Guide.ScanReport.T}" FontWeight="SemiBold" FontSize="13" />
                                    <TextBlock Text="{DynamicResource S.Help.Guide.ScanReport.B}" TextWrapping="Wrap"
                                               Foreground="{DynamicResource App.SubText}" FontSize="12"
                                               LineStackingStrategy="MaxHeight" LineHeight="18" Margin="0,4,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- ⑧ 文件回覆 -->
                        <Border Background="{DynamicResource App.Panel.Background}"
                                BorderBrush="{DynamicResource App.Border}" BorderThickness="1"
                                CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Viewbox Grid.Column="0" Width="22" Height="22" VerticalAlignment="Top" Stretch="Uniform" Margin="0,2,0,0">
                                    <Path Data="{DynamicResource Icon.Restore}" Fill="{DynamicResource App.Accent}" Stretch="Fill" />
                                </Viewbox>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                    <TextBlock Text="{DynamicResource S.Help.Guide.Restore.T}" FontWeight="SemiBold" FontSize="13" />
                                    <TextBlock Text="{DynamicResource S.Help.Guide.Restore.B}" TextWrapping="Wrap"
                                               Foreground="{DynamicResource App.SubText}" FontSize="12"
                                               LineStackingStrategy="MaxHeight" LineHeight="18" Margin="0,4,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- ⑨ 冲突与覆盖策略 -->
                        <Border Background="{DynamicResource App.Panel.Background}"
                                BorderBrush="{DynamicResource App.Border}" BorderThickness="1"
                                CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Viewbox Grid.Column="0" Width="22" Height="22" VerticalAlignment="Top" Stretch="Uniform" Margin="0,2,0,0">
                                    <Path Data="{DynamicResource Icon.Warning}" Fill="{DynamicResource App.Accent}" Stretch="Fill" />
                                </Viewbox>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                    <TextBlock Text="{DynamicResource S.Help.Guide.Conflict.T}" FontWeight="SemiBold" FontSize="13" />
                                    <TextBlock Text="{DynamicResource S.Help.Guide.Conflict.B}" TextWrapping="Wrap"
                                               Foreground="{DynamicResource App.SubText}" FontSize="12"
                                               LineStackingStrategy="MaxHeight" LineHeight="18" Margin="0,4,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- ⑩ 撤销 / 历史 / 事务 -->
                        <Border Background="{DynamicResource App.Panel.Background}"
                                BorderBrush="{DynamicResource App.Border}" BorderThickness="1"
                                CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Viewbox Grid.Column="0" Width="22" Height="22" VerticalAlignment="Top" Stretch="Uniform" Margin="0,2,0,0">
                                    <Path Data="{DynamicResource Icon.Undo}" Fill="{DynamicResource App.Accent}" Stretch="Fill" />
                                </Viewbox>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                    <TextBlock Text="{DynamicResource S.Help.Guide.Undo.T}" FontWeight="SemiBold" FontSize="13" />
                                    <TextBlock Text="{DynamicResource S.Help.Guide.Undo.B}" TextWrapping="Wrap"
                                               Foreground="{DynamicResource App.SubText}" FontSize="12"
                                               LineStackingStrategy="MaxHeight" LineHeight="18" Margin="0,4,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- ⑪ 重复检测 -->
                        <Border Background="{DynamicResource App.Panel.Background}"
                                BorderBrush="{DynamicResource App.Border}" BorderThickness="1"
                                CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Viewbox Grid.Column="0" Width="22" Height="22" VerticalAlignment="Top" Stretch="Uniform" Margin="0,2,0,0">
                                    <Path Data="{DynamicResource Icon.Duplicate}" Fill="{DynamicResource App.Accent}" Stretch="Fill" />
                                </Viewbox>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                    <TextBlock Text="{DynamicResource S.Help.Guide.Duplicate.T}" FontWeight="SemiBold" FontSize="13" />
                                    <TextBlock Text="{DynamicResource S.Help.Guide.Duplicate.B}" TextWrapping="Wrap"
                                               Foreground="{DynamicResource App.SubText}" FontSize="12"
                                               LineStackingStrategy="MaxHeight" LineHeight="18" Margin="0,4,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- ⑫ 主题 / 语言 / 界面记忆 / 更新 -->
                        <Border Background="{DynamicResource App.Panel.Background}"
                                BorderBrush="{DynamicResource App.Border}" BorderThickness="1"
                                CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Viewbox Grid.Column="0" Width="22" Height="22" VerticalAlignment="Top" Stretch="Uniform" Margin="0,2,0,0">
                                    <Path Data="{DynamicResource Icon.Appearance}" Fill="{DynamicResource App.Accent}" Stretch="Fill" />
                                </Viewbox>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                    <TextBlock Text="{DynamicResource S.Help.Guide.Settings.T}" FontWeight="SemiBold" FontSize="13" />
                                    <TextBlock Text="{DynamicResource S.Help.Guide.Settings.B}" TextWrapping="Wrap"
                                               Foreground="{DynamicResource App.SubText}" FontSize="12"
                                               LineStackingStrategy="MaxHeight" LineHeight="18" Margin="0,4,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- ⑬ 快捷键 -->
                        <Border Background="{DynamicResource App.Panel.Background}"
                                BorderBrush="{DynamicResource App.Border}" BorderThickness="1"
                                CornerRadius="6" Padding="12,10" Margin="0,0,0,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Viewbox Grid.Column="0" Width="22" Height="22" VerticalAlignment="Top" Stretch="Uniform" Margin="0,2,0,0">
                                    <Path Data="{DynamicResource Icon.Tools}" Fill="{DynamicResource App.Accent}" Stretch="Fill" />
                                </Viewbox>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                    <TextBlock Text="{DynamicResource S.Help.Guide.Keys.T}" FontWeight="SemiBold" FontSize="13" />
                                    <TextBlock Text="{DynamicResource S.Help.Guide.Keys.B}" TextWrapping="Wrap"
                                               Foreground="{DynamicResource App.SubText}" FontSize="12"
                                               LineStackingStrategy="MaxHeight" LineHeight="18" Margin="0,4,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 常见问题：12 条 Q/A -->
            <TabItem Header="{DynamicResource S.Help.FaqTab}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                    <StackPanel Margin="4,0,8,4">

                        <TextBlock Text="{DynamicResource S.Help.Faq.Q1}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{DynamicResource S.Help.Faq.A1}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource App.SubText}" Margin="0,2,0,12"
                                   LineHeight="18" LineStackingStrategy="MaxHeight" />

                        <TextBlock Text="{DynamicResource S.Help.Faq.Q2}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{DynamicResource S.Help.Faq.A2}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource App.SubText}" Margin="0,2,0,12"
                                   LineHeight="18" LineStackingStrategy="MaxHeight" />

                        <TextBlock Text="{DynamicResource S.Help.Faq.Q3}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{DynamicResource S.Help.Faq.A3}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource App.SubText}" Margin="0,2,0,12"
                                   LineHeight="18" LineStackingStrategy="MaxHeight" />

                        <TextBlock Text="{DynamicResource S.Help.Faq.Q4}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{DynamicResource S.Help.Faq.A4}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource App.SubText}" Margin="0,2,0,12"
                                   LineHeight="18" LineStackingStrategy="MaxHeight" />

                        <TextBlock Text="{DynamicResource S.Help.Faq.Q5}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{DynamicResource S.Help.Faq.A5}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource App.SubText}" Margin="0,2,0,12"
                                   LineHeight="18" LineStackingStrategy="MaxHeight" />

                        <TextBlock Text="{DynamicResource S.Help.Faq.Q6}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{DynamicResource S.Help.Faq.A6}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource App.SubText}" Margin="0,2,0,12"
                                   LineHeight="18" LineStackingStrategy="MaxHeight" />

                        <TextBlock Text="{DynamicResource S.Help.Faq.Q7}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{DynamicResource S.Help.Faq.A7}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource App.SubText}" Margin="0,2,0,12"
                                   LineHeight="18" LineStackingStrategy="MaxHeight" />

                        <TextBlock Text="{DynamicResource S.Help.Faq.Q8}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{DynamicResource S.Help.Faq.A8}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource App.SubText}" Margin="0,2,0,12"
                                   LineHeight="18" LineStackingStrategy="MaxHeight" />

                        <TextBlock Text="{DynamicResource S.Help.Faq.Q9}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{DynamicResource S.Help.Faq.A9}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource App.SubText}" Margin="0,2,0,12"
                                   LineHeight="18" LineStackingStrategy="MaxHeight" />

                        <TextBlock Text="{DynamicResource S.Help.Faq.Q10}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{DynamicResource S.Help.Faq.A10}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource App.SubText}" Margin="0,2,0,12"
                                   LineHeight="18" LineStackingStrategy="MaxHeight" />

                        <TextBlock Text="{DynamicResource S.Help.Faq.Q11}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{DynamicResource S.Help.Faq.A11}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource App.SubText}" Margin="0,2,0,12"
                                   LineHeight="18" LineStackingStrategy="MaxHeight" />

                        <TextBlock Text="{DynamicResource S.Help.Faq.Q12}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{DynamicResource S.Help.Faq.A12}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource App.SubText}" Margin="0,2,0,4"
                                   LineHeight="18" LineStackingStrategy="MaxHeight" />

                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
