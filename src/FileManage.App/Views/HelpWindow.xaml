<Window x:Class="FileManage.App.Views.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource S.Help.Title}" Width="640" Height="520" MinHeight="400" MinWidth="480"
        Background="{DynamicResource App.Window.Background}"
        Foreground="{DynamicResource App.Text}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="16">
        <!-- 底部：外链 + 关闭 -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Button Content="{DynamicResource S.Help.Close}" IsCancel="True"
                    DockPanel.Dock="Right" Padding="10,6" />
            <StackPanel Orientation="Horizontal">
                <Button Content="{DynamicResource S.Help.Homepage}" Click="OpenHomepage_Click" Padding="10,6" />
                <Button Content="{DynamicResource S.Help.Issues}" Click="OpenIssues_Click" Padding="10,6" Margin="8,0,0,0" />
            </StackPanel>
        </DockPanel>

        <TabControl x:Name="Tabs" SelectedIndex="0" Margin="0,4,0,0">
            <!-- 用户指南 -->
            <TabItem Header="{DynamicResource S.Help.GuideTab}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                    <StackPanel Margin="4,0,8,0">
                        <TextBlock Text="{DynamicResource S.Help.Guide.Quick.T}" FontWeight="Bold" />
                        <TextBlock Text="{DynamicResource S.Help.Guide.Quick.B}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource App.SubText}" Margin="0,2,0,10" />
                        <TextBlock Text="{DynamicResource S.Help.Guide.Rename.T}" FontWeight="Bold" />
                        <TextBlock Text="{DynamicResource S.Help.Guide.Rename.B}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource App.SubText}" Margin="0,2,0,10" />
                        <TextBlock Text="{DynamicResource S.Help.Guide.Classify.T}" FontWeight="Bold" />
                        <TextBlock Text="{DynamicResource S.Help.Guide.Classify.B}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource App.SubText}" Margin="0,2,0,10" />
                        <TextBlock Text="{DynamicResource S.Help.Guide.Conflict.T}" FontWeight="Bold" />
                        <TextBlock Text="{DynamicResource S.Help.Guide.Conflict.B}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource App.SubText}" Margin="0,2,0,10" />
                        <TextBlock Text="{DynamicResource S.Help.Guide.Undo.T}" FontWeight="Bold" />
                        <TextBlock Text="{DynamicResource S.Help.Guide.Undo.B}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource App.SubText}" Margin="0,2,0,10" />
                        <TextBlock Text="{DynamicResource S.Help.Guide.Keys.T}" FontWeight="Bold" />
                        <TextBlock Text="{DynamicResource S.Help.Guide.Keys.B}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource App.SubText}" Margin="0,2,0,10" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <!-- 常见问题 -->
            <TabItem Header="{DynamicResource S.Help.FaqTab}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                    <StackPanel Margin="4,0,8,0">
                        <TextBlock Text="{DynamicResource S.Help.Faq.Q1}" FontWeight="Bold" TextWrapping="Wrap" />
                        <TextBlock Text="{DynamicResource S.Help.Faq.A1}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource App.SubText}" Margin="0,2,0,10" />
                        <TextBlock Text="{DynamicResource S.Help.Faq.Q2}" FontWeight="Bold" TextWrapping="Wrap" />
                        <TextBlock Text="{DynamicResource S.Help.Faq.A2}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource App.SubText}" Margin="0,2,0,10" />
                        <TextBlock Text="{DynamicResource S.Help.Faq.Q3}" FontWeight="Bold" TextWrapping="Wrap" />
                        <TextBlock Text="{DynamicResource S.Help.Faq.A3}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource App.SubText}" Margin="0,2,0,10" />
                        <TextBlock Text="{DynamicResource S.Help.Faq.Q4}" FontWeight="Bold" TextWrapping="Wrap" />
                        <TextBlock Text="{DynamicResource S.Help.Faq.A4}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource App.SubText}" Margin="0,2,0,10" />
                        <TextBlock Text="{DynamicResource S.Help.Faq.Q5}" FontWeight="Bold" TextWrapping="Wrap" />
                        <TextBlock Text="{DynamicResource S.Help.Faq.A5}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource App.SubText}" Margin="0,2,0,10" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
