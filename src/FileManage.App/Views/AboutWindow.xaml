<Window x:Class="FileManage.App.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource S.About.Title}" Width="480" SizeToContent="Height"
        Background="{DynamicResource App.Window.Background}"
        Foreground="{DynamicResource App.Text}"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False">
    <StackPanel Margin="20">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="FileManage" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" />
            <Border Background="{DynamicResource App.Item.Selected}" CornerRadius="4"
                    Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="VersionBadge" FontWeight="Bold" FontSize="12" />
            </Border>
        </StackPanel>
        <TextBlock Text="{DynamicResource S.About.Description}"
                   Foreground="{DynamicResource App.SubText}" Margin="0,6,0,0" />

        <Separator Margin="0,14" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource S.About.Version}"
                       Foreground="{DynamicResource App.SubText}" Margin="0,0,16,6" />
            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="VersionLine" FontWeight="Bold" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource S.About.Copyright}"
                       Foreground="{DynamicResource App.SubText}" Margin="0,0,16,6" />
            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="CopyrightLine" TextWrapping="Wrap" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource S.About.License}"
                       Foreground="{DynamicResource App.SubText}" Margin="0,0,16,6" />
            <TextBlock Grid.Row="2" Grid.Column="1">
                <Hyperlink NavigateUri="https://github.com/Chris566/FileManage/blob/main/LICENSE"
                           RequestNavigate="OpenLink" Foreground="{DynamicResource App.Accent}">
                    <Run Text="{DynamicResource S.About.LicenseLink}" />
                </Hyperlink>
            </TextBlock>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="{DynamicResource S.About.Developer}"
                       Foreground="{DynamicResource App.SubText}" Margin="0,0,16,0" />
            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal">
                <TextBlock Text="吴东东（Chris）" />
                <TextBlock Margin="10,0,0,0">
                    <Hyperlink NavigateUri="https://github.com/Chris566/FileManage"
                               RequestNavigate="OpenLink" Foreground="{DynamicResource App.Accent}">
                        <Run Text="{DynamicResource S.About.Homepage}" />
                    </Hyperlink>
                </TextBlock>
                <TextBlock Margin="10,0,0,0">
                    <Hyperlink NavigateUri="https://github.com/Chris566/FileManage/issues"
                               RequestNavigate="OpenLink" Foreground="{DynamicResource App.Accent}">
                        <Run Text="{DynamicResource S.About.Issues}" />
                    </Hyperlink>
                </TextBlock>
            </StackPanel>
        </Grid>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="{DynamicResource S.About.Changelog}" Click="OpenChangelog_Click" Padding="10,6" />
            <Button Content="{DynamicResource S.About.Close}" IsCancel="True" Padding="10,6" Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>
