<Window x:Class="FileManage.App.Views.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource S.H.Title}" Height="420" Width="640" MinHeight="320" MinWidth="520"
        Background="{DynamicResource App.Window.Background}"
        Foreground="{DynamicResource App.Text}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="10">

        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="{DynamicResource S.H.UndoBatch}" Command="{Binding UndoSelectedCommand}"
                        Padding="12,6" MinWidth="92" FontWeight="Bold" />
                <Button Content="{DynamicResource S.H.DeleteRec}" Command="{Binding DeleteRecordCommand}"
                        Padding="12,6" MinWidth="92" Margin="8,0,0,0" />
                <Button Content="{DynamicResource S.RE.Close}" IsCancel="True" Padding="12,6" MinWidth="72" Margin="8,0,0,0" />
            </StackPanel>
            <TextBlock Text="{Binding ResultText}" VerticalAlignment="Center" TextWrapping="Wrap" />
        </DockPanel>

        <DataGrid ItemsSource="{Binding Batches}"
                  SelectedItem="{Binding SelectedBatch}"
                  Background="{DynamicResource App.Panel.Background}"
                  Foreground="{DynamicResource App.Text}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{DynamicResource S.H.Col.Time}" Binding="{Binding Time, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="170" />
                <DataGridTextColumn Header="{DynamicResource S.H.Col.Desc}" Binding="{Binding Description}" Width="*" />
                <DataGridTextColumn Header="{DynamicResource S.H.Col.Count}" Binding="{Binding ActionCount}" Width="80" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
