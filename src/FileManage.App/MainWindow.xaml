<Window x:Class="FileManage.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="{DynamicResource App.Window.Background}"
        Foreground="{DynamicResource App.Text}"
        Title="FileManage" Height="860" Width="1100" MinHeight="560" MinWidth="860"
        WindowStartupLocation="CenterScreen"
        Closed="OnMainWindowClosed">
    <Window.InputBindings>
        <!--  全局快捷键（菜单栏 InputGestureText 同步展示）  -->
        <KeyBinding Modifiers="Control" Key="R" Command="{Binding OpenRuleEditorCommand}" />
        <KeyBinding Modifiers="Control" Key="D" Command="{Binding OpenDuplicateCommand}" />
        <KeyBinding Modifiers="Control" Key="H" Command="{Binding OpenHistoryCommand}" />
        <KeyBinding Key="F5" Command="{Binding RefreshPreviewCommand}" />
        <KeyBinding Modifiers="Control" Key="E" Command="{Binding ExecuteCommand}" />
        <KeyBinding Modifiers="Control" Key="Z" Command="{Binding UndoCommand}" />
        <KeyBinding Key="F1" Command="{Binding OpenHelpCommand}" />
    </Window.InputBindings>
    <DockPanel>
        <!-- 顶部：菜单栏（外观 / 语言随语言字典切换；工具组带快捷键提示） -->
        <Menu DockPanel.Dock="Top" Padding="4,0">
            <MenuItem Header="{DynamicResource S.Menu.Appearance}">
                <MenuItem.Icon>
                    <Path Style="{StaticResource AppIcon16}" Data="{DynamicResource Icon.Appearance}" />
                </MenuItem.Icon>
                <MenuItem Header="{DynamicResource S.Theme.Light}" IsCheckable="True"
                          IsChecked="{Binding IsLightTheme, Mode=TwoWay}" />
                <MenuItem Header="{DynamicResource S.Theme.Dark}" IsCheckable="True"
                          IsChecked="{Binding IsDarkTheme, Mode=TwoWay}" />
            </MenuItem>
            <MenuItem Header="{DynamicResource S.Menu.Language}">
                <MenuItem.Icon>
                    <Path Style="{StaticResource AppIcon16}" Data="{DynamicResource Icon.Language}" />
                </MenuItem.Icon>
                <MenuItem Header="中文" IsCheckable="True"
                          IsChecked="{Binding IsChinese, Mode=TwoWay}" />
                <MenuItem Header="English" IsCheckable="True"
                          IsChecked="{Binding IsEnglish, Mode=TwoWay}" />
            </MenuItem>
            <MenuItem Header="{DynamicResource S.Menu.Tools}">
                <MenuItem.Icon>
                    <Path Style="{StaticResource AppIcon16}" Data="{DynamicResource Icon.Tools}" />
                </MenuItem.Icon>
                <MenuItem Header="{DynamicResource S.RuleEditor}" Command="{Binding OpenRuleEditorCommand}"
                          InputGestureText="Ctrl+R">
                    <MenuItem.Icon>
                        <Path Style="{StaticResource AppIcon16}" Data="{DynamicResource Icon.RuleEditor}" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{DynamicResource S.Duplicate}" Command="{Binding OpenDuplicateCommand}"
                          InputGestureText="Ctrl+D">
                    <MenuItem.Icon>
                        <Path Style="{StaticResource AppIcon16}" Data="{DynamicResource Icon.Duplicate}" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{DynamicResource S.History}" Command="{Binding OpenHistoryCommand}"
                          InputGestureText="Ctrl+H">
                    <MenuItem.Icon>
                        <Path Style="{StaticResource AppIcon16}" Data="{DynamicResource Icon.History}" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="{DynamicResource S.Refresh}" Command="{Binding RefreshPreviewCommand}"
                          InputGestureText="F5">
                    <MenuItem.Icon>
                        <Path Style="{StaticResource AppIcon16}" Data="{DynamicResource Icon.Refresh}" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{DynamicResource S.Execute}" Command="{Binding ExecuteCommand}"
                          InputGestureText="Ctrl+E">
                    <MenuItem.Icon>
                        <Path Style="{StaticResource AppIcon16}" Data="{DynamicResource Icon.Execute}" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{DynamicResource S.UndoLast}" Command="{Binding UndoCommand}"
                          InputGestureText="Ctrl+Z">
                    <MenuItem.Icon>
                        <Path Style="{StaticResource AppIcon16}" Data="{DynamicResource Icon.Undo}" />
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="{DynamicResource S.Menu.Help}">
                <MenuItem.Icon>
                    <Path Style="{StaticResource AppIcon16}" Data="{DynamicResource Icon.Help}" />
                </MenuItem.Icon>
                <MenuItem Header="{DynamicResource S.Menu.Guide}" Command="{Binding OpenHelpCommand}"
                          InputGestureText="F1">
                    <MenuItem.Icon>
                        <Path Style="{StaticResource AppIcon16}" Data="{DynamicResource Icon.Guide}" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{DynamicResource S.Menu.Faq}" Command="{Binding OpenHelpFaqCommand}">
                    <MenuItem.Icon>
                        <Path Style="{StaticResource AppIcon16}" Data="{DynamicResource Icon.Faq}" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="{DynamicResource S.Menu.Homepage}" Command="{Binding OpenHomepageCommand}">
                    <MenuItem.Icon>
                        <Path Style="{StaticResource AppIcon16}" Data="{DynamicResource Icon.Homepage}" />
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="{DynamicResource S.Menu.About}">
                <MenuItem.Icon>
                    <Path Style="{StaticResource AppIcon16}" Data="{DynamicResource Icon.About}" />
                </MenuItem.Icon>
                <MenuItem Header="{DynamicResource S.Menu.AboutThis}" Command="{Binding OpenAboutCommand}" />
            </MenuItem>
        </Menu>

        <!-- 顶部：操作工具栏（图标+文字；WrapPanel 防窄窗口溢出；悬停显示详细提示） -->
        <WrapPanel DockPanel.Dock="Top" Margin="4,0,4,4">
            <Button Style="{StaticResource AppToolBarButton}"
                    ToolTip="{DynamicResource S.Tip.Refresh}"
                    Command="{Binding RefreshPreviewCommand}">
                <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource AppIcon20}" Data="{DynamicResource Icon.Refresh}" VerticalAlignment="Center" />
                    <TextBlock Text="{DynamicResource S.Refresh}" VerticalAlignment="Center" Margin="6,0,0,0" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource AppToolBarButton}"
                    ToolTip="{DynamicResource S.Tip.Execute}"
                    Command="{Binding ExecuteCommand}" Margin="8,0,0,0">
                <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource AppIcon20}" Data="{DynamicResource Icon.Execute}" VerticalAlignment="Center" />
                    <TextBlock Text="{DynamicResource S.Execute}" VerticalAlignment="Center" Margin="6,0,0,0" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource AppToolBarButton}"
                    ToolTip="{DynamicResource S.Tip.Undo}"
                    Command="{Binding UndoCommand}" Margin="8,0,0,0">
                <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource AppIcon20}" Data="{DynamicResource Icon.Undo}" VerticalAlignment="Center" />
                    <TextBlock Text="{DynamicResource S.UndoLast}" VerticalAlignment="Center" Margin="6,0,0,0" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource AppToolBarButton}"
                    ToolTip="{DynamicResource S.Tip.History}"
                    Command="{Binding OpenHistoryCommand}" Margin="8,0,0,0">
                <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource AppIcon20}" Data="{DynamicResource Icon.History}" VerticalAlignment="Center" />
                    <TextBlock Text="{DynamicResource S.History}" VerticalAlignment="Center" Margin="6,0,0,0" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource AppToolBarButton}"
                    ToolTip="{DynamicResource S.Tip.Duplicate}"
                    Command="{Binding OpenDuplicateCommand}" Margin="8,0,0,0">
                <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource AppIcon20}" Data="{DynamicResource Icon.Duplicate}" VerticalAlignment="Center" />
                    <TextBlock Text="{DynamicResource S.Duplicate}" VerticalAlignment="Center" Margin="6,0,0,0" />
                </StackPanel>
            </Button>
        </WrapPanel>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <DockPanel LastChildFill="False" />
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>
            <StatusBarItem>
                <ProgressBar Width="220" Height="14" Maximum="100"
                             Value="{Binding ProgressPercent, Mode=OneWay}" />
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}" />
            </StatusBarItem>
            <!-- 版本标签：与关于窗口同源；悬停显示完整版本与构建日期，点击打开关于窗口 -->
            <StatusBarItem DockPanel.Dock="Right">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="PowerBy 吴东东（Chris）"
                               FontSize="11" Foreground="{DynamicResource App.SubText}" VerticalAlignment="Center" />
                    <Button Style="{StaticResource AppLinkButton}"
                            Content="{Binding VersionText}" ToolTip="{Binding VersionToolTip}"
                            Command="{Binding OpenAboutCommand}" Margin="8,0,0,0" />
                </StackPanel>
            </StatusBarItem>
        </StatusBar>

        <Grid Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左列：参数区 -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,8,0"
                          Style="{StaticResource AppScrollViewerStyle}"
                          Background="{DynamicResource App.Window.Background}">
                <Grid MinHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <!--  执行选项行：吸收剩余高度，使左列底边与预览区底边对齐  -->
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <GroupBox Grid.Row="0" Style="{StaticResource AppCollapsibleGroup}"
                              Tag="{Binding SourceGroupExpanded, Mode=TwoWay}" Padding="8">
                        <GroupBox.Header>
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource AppIcon16}" Data="{DynamicResource Icon.Source}" VerticalAlignment="Center" />
                                <TextBlock Text="{DynamicResource S.SourceDir}" VerticalAlignment="Center" Margin="6,0,0,0" />
                            </StackPanel>
                        </GroupBox.Header>
                        <StackPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="{DynamicResource S.Browse}"
                                        Command="{Binding BrowseSourceCommand}"
                                        Margin="4,0,0,0" Padding="8,4" />
                                <TextBox Text="{Binding SourceDirectory, UpdateSourceTrigger=PropertyChanged}"
                                         VerticalContentAlignment="Center" />
                            </DockPanel>
                            <CheckBox Content="{DynamicResource S.IncludeSub}"
                                      IsChecked="{Binding IncludeSubdirectories}"
                                      Margin="0,8,0,0" />
                            <TextBlock Text="{DynamicResource S.IncludeGlobs}" Margin="0,8,0,2" />
                            <TextBox Text="{Binding IncludeGlobs, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="{DynamicResource S.ExcludeGlobs}" Margin="0,8,0,2" />
                            <TextBox Text="{Binding ExcludeGlobs, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Grid.Row="1" Style="{StaticResource AppCollapsibleGroup}"
                              Tag="{Binding RenameGroupExpanded, Mode=TwoWay}" Padding="8" Margin="0,8,0,0">
                        <GroupBox.Header>
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource AppIcon16}" Data="{DynamicResource Icon.RenameGroup}" VerticalAlignment="Center" />
                                <TextBlock Text="{DynamicResource S.Rename}" VerticalAlignment="Center" Margin="6,0,0,0" />
                            </StackPanel>
                        </GroupBox.Header>
                        <StackPanel>
                            <CheckBox Content="{DynamicResource S.RenameEnabled}" IsChecked="{Binding NamingEnabled}" />
                            <TextBlock Text="{DynamicResource S.Template}" Margin="0,8,0,2" />
                            <ComboBox SelectedIndex="{Binding SelectedTemplateIndex}">
                                <ComboBoxItem Content="{DynamicResource S.Template.PrefixOriginal}" />
                                <ComboBoxItem Content="{DynamicResource S.Template.PrefixIndexOriginal}" />
                                <ComboBoxItem Content="{DynamicResource S.Template.Original}" />
                                <ComboBoxItem Content="{DynamicResource S.Template.IndexOriginal}" />
                            </ComboBox>
                            <TextBlock Text="{DynamicResource S.Prefix}" Margin="0,8,0,2" />
                            <TextBox Text="{Binding Prefix, UpdateSourceTrigger=PropertyChanged}" />
                            <CheckBox Content="{DynamicResource S.KeepExt}"
                                      IsChecked="{Binding KeepOriginalExtension}"
                                      Margin="0,8,0,0" />
                            <CheckBox Content="{DynamicResource S.ReadExif}"
                                      IsChecked="{Binding ReadExifDate}"
                                      Margin="0,8,0,0" />
                            <Button Content="{Binding ReplaceChainButtonText}"
                                    Command="{Binding OpenReplaceChainCommand}"
                                    HorizontalAlignment="Left" Padding="8,4" Margin="0,8,0,0" />
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Grid.Row="2" Style="{StaticResource AppCollapsibleGroup}"
                              Tag="{Binding ClassifyGroupExpanded, Mode=TwoWay}" Padding="8" Margin="0,8,0,0">
                        <GroupBox.Header>
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource AppIcon16}" Data="{DynamicResource Icon.Classify}" VerticalAlignment="Center" />
                                <TextBlock Text="{DynamicResource S.Classify}" VerticalAlignment="Center" Margin="6,0,0,0" />
                            </StackPanel>
                        </GroupBox.Header>
                        <StackPanel>
                            <CheckBox Content="{DynamicResource S.ClassifyEnabled}"
                                      IsChecked="{Binding ClassificationEnabled}" />
                            <DockPanel Margin="0,8,0,0">
                                <Button DockPanel.Dock="Right" Content="{DynamicResource S.Browse}"
                                        Command="{Binding BrowseTargetCommand}"
                                        Margin="4,0,0,0" Padding="8,4" />
                                <TextBox Text="{Binding TargetDirectory, UpdateSourceTrigger=PropertyChanged}"
                                         VerticalContentAlignment="Center" />
                            </DockPanel>
                            <CheckBox Content="{DynamicResource S.Copy}"
                                      IsChecked="{Binding CopyInsteadOfMove}"
                                      Margin="0,8,0,0" />
                            <CheckBox Content="{DynamicResource S.GenerateReport}"
                                      IsChecked="{Binding GenerateReport}"
                                      Margin="0,8,0,0" />
                            <Button Content="{DynamicResource S.RuleEditor}"
                                    Command="{Binding OpenRuleEditorCommand}"
                                    HorizontalAlignment="Left" Padding="8,4" Margin="0,8,0,0" />
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Grid.Row="3" Style="{StaticResource AppCollapsibleGroup}"
                              Tag="{Binding ExecOptionsGroupExpanded, Mode=TwoWay}" Padding="8" Margin="0,8,0,0">
                        <GroupBox.Header>
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource AppIcon16}" Data="{DynamicResource Icon.ExecOptions}" VerticalAlignment="Center" />
                                <TextBlock Text="{DynamicResource S.ExecOptions}" VerticalAlignment="Center" Margin="6,0,0,0" />
                            </StackPanel>
                        </GroupBox.Header>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource S.WhenExists}" Margin="0,0,0,2" />
                            <ComboBox SelectedIndex="{Binding SelectedPolicyIndex}">
                                <ComboBoxItem Content="{DynamicResource S.Policy.Ask}" />
                                <ComboBoxItem Content="{DynamicResource S.Policy.OverwriteAll}" />
                                <ComboBoxItem Content="{DynamicResource S.Policy.SkipAll}" />
                            </ComboBox>
                        </StackPanel>
                    </GroupBox>
                </Grid>
            </ScrollViewer>

            <!-- 右列：预览区 -->
            <DataGrid Grid.Column="1"
                      Background="{DynamicResource App.Panel.Background}"
                      Foreground="{DynamicResource App.Text}"
                      ItemsSource="{Binding PreviewRows}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{DynamicResource S.Col.Original}" Binding="{Binding OriginalName}" Width="2*" />
                    <DataGridTextColumn Header="{DynamicResource S.Col.New}" Binding="{Binding NewName}" Width="2*" />
                    <DataGridTextColumn Header="{DynamicResource S.Col.Category}" Binding="{Binding Category}" Width="80" />
                    <DataGridTextColumn Header="{DynamicResource S.Col.Operation}" Binding="{Binding Target}" Width="2.4*" />
                    <DataGridTextColumn Header="{DynamicResource S.Col.Conflict}" Binding="{Binding Conflict}" Width="150" />
                </DataGrid.Columns>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ConflictType}" Value="PlanDuplicate">
                                <Setter Property="Background" Value="{DynamicResource App.Conflict.PlanDuplicate}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ConflictType}" Value="TargetExists">
                                <Setter Property="Background" Value="{DynamicResource App.Conflict.TargetExists}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ConflictType}" Value="PathTooLong">
                                <Setter Property="Background" Value="{DynamicResource App.Conflict.Blocked}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ConflictType}" Value="InvalidChars">
                                <Setter Property="Background" Value="{DynamicResource App.Conflict.Blocked}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
            </DataGrid>
        </Grid>
    </DockPanel>
</Window>
