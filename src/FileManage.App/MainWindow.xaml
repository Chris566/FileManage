<Window x:Class="FileManage.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FileManage" Height="720" Width="1100" MinHeight="560" MinWidth="860"
        WindowStartupLocation="CenterScreen"
        Closed="OnMainWindowClosed">
    <DockPanel>
        <!-- 顶部：标题 + 主题/语言切换 -->
        <DockPanel DockPanel.Dock="Top" Margin="4">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <ComboBox SelectedIndex="{Binding SelectedThemeIndex}" MinWidth="80">
                    <ComboBoxItem Content="{DynamicResource S.Theme.Light}" />
                    <ComboBoxItem Content="{DynamicResource S.Theme.Dark}" />
                </ComboBox>
                <ComboBox SelectedIndex="{Binding SelectedLanguageIndex}" MinWidth="100" Margin="8,0,0,0">
                    <ComboBoxItem Content="中文" />
                    <ComboBoxItem Content="English" />
                </ComboBox>
            </StackPanel>
            <TextBlock Text="FileManage" FontWeight="Bold" VerticalAlignment="Center" />
        </DockPanel>

        <!-- 顶部：操作工具栏（WrapPanel 防窄窗口溢出） -->
        <WrapPanel DockPanel.Dock="Top" Margin="4,0,4,4">
            <Button Content="{DynamicResource S.Refresh}" Command="{Binding RefreshPreviewCommand}"
                    Padding="12,6" MinWidth="92" />
            <Button Content="{DynamicResource S.Execute}" Command="{Binding ExecuteCommand}"
                    Padding="12,6" MinWidth="92" Margin="8,0,0,0" />
            <Button Content="{DynamicResource S.UndoLast}" Command="{Binding UndoCommand}"
                    Padding="12,6" MinWidth="92" Margin="8,0,0,0" />
            <Button Content="{DynamicResource S.History}" Command="{Binding OpenHistoryCommand}"
                    Padding="12,6" MinWidth="72" Margin="8,0,0,0" />
            <Button Content="{DynamicResource S.Duplicate}" Command="{Binding OpenDuplicateCommand}"
                    Padding="12,6" MinWidth="92" Margin="8,0,0,0" />
        </WrapPanel>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <ProgressBar Width="220" Height="14" Maximum="100"
                             Value="{Binding ProgressPercent, Mode=OneWay}" />
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}" />
            </StatusBarItem>
        </StatusBar>

        <Grid Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左列：参数区 -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,8,0">
                <StackPanel>
                    <GroupBox Header="{DynamicResource S.SourceDir}" Padding="8">
                        <StackPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="{DynamicResource S.Browse}"
                                        Command="{Binding BrowseSourceCommand}"
                                        Margin="4,0,0,0" Padding="8,4" />
                                <TextBox Text="{Binding SourceDirectory, UpdateSourceTrigger=PropertyChanged}"
                                         VerticalContentAlignment="Center" />
                            </DockPanel>
                            <CheckBox Content="{DynamicResource S.IncludeSub}"
                                      IsChecked="{Binding IncludeSubdirectories}"
                                      Margin="0,8,0,0" />
                            <TextBlock Text="{DynamicResource S.IncludeGlobs}" Margin="0,8,0,2" />
                            <TextBox Text="{Binding IncludeGlobs, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="{DynamicResource S.ExcludeGlobs}" Margin="0,8,0,2" />
                            <TextBox Text="{Binding ExcludeGlobs, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="{DynamicResource S.Rename}" Padding="8" Margin="0,8,0,0">
                        <StackPanel>
                            <CheckBox Content="{DynamicResource S.RenameEnabled}" IsChecked="{Binding NamingEnabled}" />
                            <TextBlock Text="{DynamicResource S.Template}" Margin="0,8,0,2" />
                            <ComboBox ItemsSource="{Binding Templates}"
                                      SelectedItem="{Binding SelectedTemplate}"
                                      DisplayMemberPath="DisplayName" />
                            <TextBlock Text="{DynamicResource S.Prefix}" Margin="0,8,0,2" />
                            <TextBox Text="{Binding Prefix, UpdateSourceTrigger=PropertyChanged}" />
                            <CheckBox Content="{DynamicResource S.KeepExt}"
                                      IsChecked="{Binding KeepOriginalExtension}"
                                      Margin="0,8,0,0" />
                            <CheckBox Content="{DynamicResource S.ReadExif}"
                                      IsChecked="{Binding ReadExifDate}"
                                      Margin="0,8,0,0" />
                            <Button Content="{Binding ReplaceChainButtonText}"
                                    Command="{Binding OpenReplaceChainCommand}"
                                    HorizontalAlignment="Left" Padding="8,4" Margin="0,8,0,0" />
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="{DynamicResource S.Classify}" Padding="8" Margin="0,8,0,0">
                        <StackPanel>
                            <CheckBox Content="{DynamicResource S.ClassifyEnabled}"
                                      IsChecked="{Binding ClassificationEnabled}" />
                            <DockPanel Margin="0,8,0,0">
                                <Button DockPanel.Dock="Right" Content="{DynamicResource S.Browse}"
                                        Command="{Binding BrowseTargetCommand}"
                                        Margin="4,0,0,0" Padding="8,4" />
                                <TextBox Text="{Binding TargetDirectory, UpdateSourceTrigger=PropertyChanged}"
                                         VerticalContentAlignment="Center" />
                            </DockPanel>
                            <CheckBox Content="{DynamicResource S.Copy}"
                                      IsChecked="{Binding CopyInsteadOfMove}"
                                      Margin="0,8,0,0" />
                            <CheckBox Content="{DynamicResource S.GenerateReport}"
                                      IsChecked="{Binding GenerateReport}"
                                      Margin="0,8,0,0" />
                            <Button Content="{DynamicResource S.RuleEditor}"
                                    Command="{Binding OpenRuleEditorCommand}"
                                    HorizontalAlignment="Left" Padding="8,4" Margin="0,8,0,0" />
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="{DynamicResource S.ExecOptions}" Padding="8" Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource S.WhenExists}" Margin="0,0,0,2" />
                            <ComboBox ItemsSource="{Binding Policies}"
                                      SelectedItem="{Binding SelectedPolicy}" />
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>

            <!-- 右列：预览区 -->
            <DataGrid Grid.Column="1"
                      Background="{DynamicResource App.Panel.Background}"
                      Foreground="{DynamicResource App.Text}"
                      ItemsSource="{Binding PreviewRows}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{DynamicResource S.Col.Original}" Binding="{Binding OriginalName}" Width="2*" />
                    <DataGridTextColumn Header="{DynamicResource S.Col.New}" Binding="{Binding NewName}" Width="2*" />
                    <DataGridTextColumn Header="{DynamicResource S.Col.Category}" Binding="{Binding Category}" Width="80" />
                    <DataGridTextColumn Header="{DynamicResource S.Col.Operation}" Binding="{Binding Target}" Width="2.4*" />
                    <DataGridTextColumn Header="{DynamicResource S.Col.Conflict}" Binding="{Binding Conflict}" Width="150" />
                </DataGrid.Columns>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ConflictType}" Value="PlanDuplicate">
                                <Setter Property="Background" Value="{DynamicResource App.Conflict.PlanDuplicate}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ConflictType}" Value="TargetExists">
                                <Setter Property="Background" Value="{DynamicResource App.Conflict.TargetExists}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ConflictType}" Value="PathTooLong">
                                <Setter Property="Background" Value="{DynamicResource App.Conflict.Blocked}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ConflictType}" Value="InvalidChars">
                                <Setter Property="Background" Value="{DynamicResource App.Conflict.Blocked}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
            </DataGrid>
        </Grid>
    </DockPanel>
</Window>
